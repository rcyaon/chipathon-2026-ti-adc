echo INTERMEDIATE_RUN_6_REQUESTED_DIFF_p2mV
echo ============================================================
print actual_diff_mv_6
print decision_time_ns_6
print kb_before_dec_mv_6 kb_before_dec_lsb_6
print kb_at_dec_mv_6 kb_at_dec_lsb_6
print kb_peak_2ns_mv_6 kb_peak_2ns_lsb_6
print kb_residual_2ns_mv_6 kb_residual_2ns_lsb_6
print outdiff_final_6 decision_metric_6

