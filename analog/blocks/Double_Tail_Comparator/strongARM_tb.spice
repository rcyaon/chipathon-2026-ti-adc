* ============================================================
* SAR ADC Comparator Decision-Time + Differential-Kickback Sweep (V3)
* Measures across +/-1, +/-2, +/-5, +/-10 mV input differentials:
*   1) Comparator decision time
*   2) Kickback accumulated before comparator resolution
*   3) Kickback at the decision instant
*   4) Peak and residual kickback
*
* DUTs:
*   - XCDAC_U: unloaded reference CDAC
*   - XCDAC_L: identical CDAC with comparator INP attached to Vx_loaded
*
* Test condition:
*   - 8-bit effective code = 128 (midscale)
*   - Dx<0> and Dx<5> are dummy-unit controls and are held LOW
*   - Sampling/top-plate reset ends at 20 ns
*   - Comparator fires at 60 ns, after the CDAC has settled
* ============================================================

.GLOBAL GND

* ============================================================
* GF180MCU models -- copied from the supplied working testbench
* ============================================================
.include "$PDK_ROOT/gf180mcuD/libs.tech/ngspice/design.ngspice"
.lib "$PDK_ROOT/gf180mcuD/libs.tech/ngspice/sm141064.ngspice" typical
.lib "$PDK_ROOT/gf180mcuD/libs.tech/ngspice/sm141064.ngspice" cap_mim

.param mim_corner_2p0fF=1
.param mc_c_cox_2p0fF=0

* ============================================================
* ADC parameters
* ============================================================
.param VDDVAL=3.3
.param VREFVAL=1.8
.param VCMVAL=0.9
.param VINVAL=0.9
.param NBITS=8

* 1 LSB = VREF/256 = 7.03125 mV for VREF=1.8 V
* 0.5 LSB = 3.515625 mV
.param LSB='VREFVAL/(2^NBITS)'
.param HALFLSB='LSB/2'

* ============================================================
* Rails / analog inputs
* ============================================================
VDD_SRC   VDD  GND {VDDVAL}
VREF_SRC  VREF GND {VREFVAL}
VIN_SRC   Vin  GND {VINVAL}
VCM_SRC   VCM  GND {VCMVAL}

* ============================================================
* Sampling / conversion clocks
*
* 0..19 ns:
*   phi_b = 1, ~phi_b = 0 -> capacitor bottom plates sample Vin
*   phi_t = 1, ~phi_t = 0 -> Vx / Vx_lsb reset to VCM
*
* 19..20 ns:
*   1 ns transition into conversion
*
* >=20 ns:
*   phi_b = 0, ~phi_b = 1 -> CDAC bottom plates use Dx controls
*   phi_t = 0, ~phi_t = 1 -> top plates released from VCM
* ============================================================
VPHIB    phi_b   GND PWL(0 {VDDVAL} 19n {VDDVAL} 20n 0 80n 0)
VPHIB_B  phi_b_b GND PWL(0 0 19n 0 20n {VDDVAL} 80n {VDDVAL})

VPHIT    phi_t   GND PWL(0 {VDDVAL} 19n {VDDVAL} 20n 0 80n 0)
VPHIT_B  phi_t_b GND PWL(0 0 19n 0 20n {VDDVAL} 80n {VDDVAL})

* ============================================================
* Effective 8-bit code = 128
*
* Active 8-bit word:
*   bit0 -> Dx<1>
*   bit1 -> Dx<2>
*   bit2 -> Dx<3>
*   bit3 -> Dx<4>
*   bit4 -> Dx<6>
*   bit5 -> Dx<7>
*   bit6 -> Dx<8>
*   bit7 -> Dx<9>
*
* Dummy controls:
*   Dx<0> and Dx<5> held LOW
* ============================================================

* Dummy unit controls
VDX0    Dx0   GND 0
VDXB0   Dxb0  GND {VDDVAL}
VDX5    Dx5   GND 0
VDXB5   Dxb5  GND {VDDVAL}

* Code 128 = 1000_0000
VDX1    Dx1   GND 0
VDXB1   Dxb1  GND {VDDVAL}

VDX2    Dx2   GND 0
VDXB2   Dxb2  GND {VDDVAL}

VDX3    Dx3   GND 0
VDXB3   Dxb3  GND {VDDVAL}

VDX4    Dx4   GND 0
VDXB4   Dxb4  GND {VDDVAL}

VDX6    Dx6   GND 0
VDXB6   Dxb6  GND {VDDVAL}

VDX7    Dx7   GND 0
VDXB7   Dxb7  GND {VDDVAL}

VDX8    Dx8   GND 0
VDXB8   Dxb8  GND {VDDVAL}

VDX9    Dx9   GND {VDDVAL}
VDXB9   Dxb9  GND 0

* ============================================================
* Comparator clock
*
* Comparator is intentionally held in reset while CDAC settles.
* It fires at 60 ns. The fast edge makes kickback easy to see.
* Change rise/fall time here if your real comparator clock is slower.
* ============================================================
VCLK CLK GND PULSE(0 {VDDVAL} 60n 50p 50p 5n 40n)

* ============================================================
* CDAC instances
*
* Exact positional pin order from the supplied caps2 netlist:
*
* caps2 Dx_b<0> Dx_b<1> Dx_b<2> Dx_b<3> Vin Dx_b<4> Dx_b<5>
*       GND Dx_b<6> Dx_b<7> VREF Dx_b<8> ~phi_t phi_t Dx_b<9>
*       Dx<0> VDD Dx<1> Vx Dx<2> Dx<3> Vx_lsb Dx<4> Dx<5>
*       phi_b ~phi_b Dx<6> VCM Dx<7> Dx<8> Dx<9>
* ============================================================

* Unloaded CDAC: reference for input-loading comparison
XCDAC_U Dxb0 Dxb1 Dxb2 Dxb3 Vin Dxb4 Dxb5 GND Dxb6 Dxb7 VREF Dxb8 phi_t_b phi_t Dxb9 Dx0
+ VDD Dx1 Vx_unloaded Dx2 Dx3 Vx_lsb_u Dx4 Dx5 phi_b phi_b_b Dx6 VCM Dx7 Dx8 Dx9 caps2

* Loaded CDAC: comparator input connected to Vx_loaded
XCDAC_L Dxb0 Dxb1 Dxb2 Dxb3 Vin Dxb4 Dxb5 GND Dxb6 Dxb7 VREF Dxb8 phi_t_b phi_t Dxb9 Dx0
+ VDD Dx1 Vx_loaded Dx2 Dx3 Vx_lsb_l Dx4 Dx5 phi_b phi_b_b Dx6 VCM Dx7 Dx8 Dx9 caps2

* ============================================================
* Comparator
*
* Exact positional pin order from supplied comparator:
* realcomp OUTN OUTP CLK VSS VDD INP INN
*
* INP = loaded CDAC Vx
* INN = VCOMP, an independently swept reference.
*
* VCOMP is swept around the measured pre-comparison Vx so that
* actual INP-INN is approximately:
*   -10, -5, -2, -1, +1, +2, +5, +10 mV
*
* Keeping INP physically attached to Vx_loaded preserves the
* comparator loading and kickback path that we are trying to test.
* ============================================================
VCOMPREF VCOMP GND {VCMVAL}
XCOMP OUTN OUTP CLK GND VDD Vx_loaded VCOMP realcomp

* ============================================================
* Simulation settings
* ============================================================
.options method=gear maxord=2 reltol=1e-4 abstol=1p vntol=100n chgtol=1e-15
.options gmin=1e-12 rshunt=1e12 itl1=500 itl4=300

* Small max step is important for resolving the kickback spike.
.tran 10p 80n

.control
set noaskquit

* ============================================================
* ROBUST COMPARATOR DECISION-TIME + KICKBACK SWEEP, V3
*
* Fixed from V1:
*   1) No calibration vectors are destroyed.
*   2) VCOMP is altered to eight EXPLICIT voltage values.
*   3) Decision threshold is literal 1.65 V.
*   4) LSB is literal 7.03125 mV.
*   5) Differential output uses v(OUTN)-v(OUTP).
*   6) Correctness uses a multiplication metric, not a boolean.
*
* decision_metric > 0 : comparator polarity is correct
* decision_metric < 0 : comparator polarity is wrong
*
* Sweep center:
*   measured Vx before CLK = 0.9031209 V
* ============================================================

* ============================================================
* RUN 1: requested INP-INN = -10 mV
* ============================================================
alter VCOMPREF 0.9131209
run

let kb_raw = v(Vx_loaded)-v(Vx_unloaded)
meas tran kb_pre_1 FIND kb_raw AT=59.9n
let kb_dyn_1 = kb_raw-kb_pre_1
let kb_abs_1 = abs(kb_dyn_1)

let outdiff_1 = v(OUTN)-v(OUTP)
let outdiff_abs_1 = abs(outdiff_1)

meas tran vx_pre_1 FIND v(Vx_loaded) AT=59.9n
meas tran vcomp_pre_1 FIND v(VCOMP) AT=59.9n
let actual_diff_1 = vx_pre_1-vcomp_pre_1

meas tran t_clk50_1 WHEN v(CLK)=1.65 RISE=1 FROM=59.9n TO=60.2n
meas tran t_dec_abs_1 WHEN outdiff_abs_1=1.65 RISE=1 FROM=60n TO=64.9n
let t_decision_1 = t_dec_abs_1-t_clk50_1

meas tran kb_before_dec_1 MAX kb_abs_1 FROM=$&t_clk50_1 TO=$&t_dec_abs_1
meas tran kb_at_dec_1 FIND kb_dyn_1 AT=$&t_dec_abs_1

meas tran kb_peak_2ns_1 MAX kb_abs_1 FROM=60n TO=62n
meas tran kb_residual_2ns_1 FIND kb_dyn_1 AT=62n
meas tran kb_pos_1 MAX kb_dyn_1 FROM=60n TO=62n
meas tran kb_neg_1 MIN kb_dyn_1 FROM=60n TO=62n

meas tran outdiff_final_1 FIND outdiff_1 AT=64.5n
let decision_metric_1 = actual_diff_1*outdiff_final_1

let actual_diff_mv_1 = actual_diff_1*1e3
let decision_time_ns_1 = t_decision_1*1e9
let kb_before_dec_mv_1 = kb_before_dec_1*1e3
let kb_before_dec_lsb_1 = kb_before_dec_1/0.00703125
let kb_at_dec_mv_1 = kb_at_dec_1*1e3
let kb_at_dec_lsb_1 = abs(kb_at_dec_1)/0.00703125
let kb_peak_2ns_mv_1 = kb_peak_2ns_1*1e3
let kb_peak_2ns_lsb_1 = kb_peak_2ns_1/0.00703125
let kb_residual_2ns_mv_1 = kb_residual_2ns_1*1e3
let kb_residual_2ns_lsb_1 = abs(kb_residual_2ns_1)/0.00703125

echo
echo ============================================================
echo INTERMEDIATE_RUN_1_REQUESTED_DIFF_m10mV
echo ============================================================
print actual_diff_mv_1
print decision_time_ns_1
print kb_before_dec_mv_1 kb_before_dec_lsb_1
print kb_at_dec_mv_1 kb_at_dec_lsb_1
print kb_peak_2ns_mv_1 kb_peak_2ns_lsb_1
print kb_residual_2ns_mv_1 kb_residual_2ns_lsb_1
print outdiff_final_1 decision_metric_1

wrdata comparator_sweep_run_1_m10mV.txt time kb_dyn_1 outdiff_abs_1 v(Vx_loaded) v(Vx_unloaded) v(CLK) v(OUTP) v(OUTN)

