* ============================================================
.subckt caps2 Dx_b<0> Dx_b<1> Dx_b<2> Dx_b<3> Vin Dx_b<4> Dx_b<5> GND Dx_b<6> Dx_b<7> VREF Dx_b<8> ~phi_t phi_t Dx_b<9> Dx<0>
+ VDD Dx<1> Vx Dx<2> Dx<3> Vx_lsb Dx<4> Dx<5> phi_b ~phi_b Dx<6> VCM Dx<7> Dx<8> Dx<9>
XC1 net2 Vx_lsb cap_mim_2f0fF c_width=5e-6 c_length=5e-6
XC2 net1 Vx_lsb cap_mim_2f0fF c_width=5e-6 c_length=5e-6
XC3 net3 Vx_lsb cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=2
XC4 net4 Vx_lsb cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=4
XC5 net5 Vx_lsb cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=8
XC6 net6 Vx cap_mim_2f0fF c_width=5e-6 c_length=5e-6
XC7 net7 Vx cap_mim_2f0fF c_width=5e-6 c_length=5e-6
XC8 net8 Vx cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=2
XC9 net9 Vx cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=4
XC10 net10 Vx cap_mim_2f0fF c_width=5e-6 c_length=5e-6 m=8
XC11 Vx_lsb Vx cap_mim_2f0fF c_width=5.16e-6 c_length=5.16e-6
XM4 VCM ~phi_t Vx VDD pfet_03v3 L=0.28u W=2u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)'
+ ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
XM1 Vx phi_t VCM GND nfet_03v3 L=0.28u W=1u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)'
+ ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
XM2 VCM ~phi_t Vx_lsb VDD pfet_03v3 L=0.28u W=2u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)'
+ ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
XM3 Vx_lsb phi_t VCM GND nfet_03v3 L=0.28u W=1u nf=1 ad='int((nf+1)/2) * W/nf * 0.18u' as='int((nf+2)/2) * W/nf * 0.18u' pd='2*int((nf+1)/2) * (W/nf + 0.18u)'
+ ps='2*int((nf+2)/2) * (W/nf + 0.18u)' nrd='0.18u / W' nrs='0.18u / W' sa=0 sb=0 sd=0
x1 VDD Dx<0> Dx_b<0> VREF ~phi_b phi_b Vin net2 GND transistors3
x2 VDD Dx<2> Dx_b<2> VREF ~phi_b phi_b Vin net3 GND transistors3
x3 VDD Dx<4> Dx_b<4> VREF ~phi_b phi_b Vin net5 GND transistors3
x4 VDD Dx<5> Dx_b<5> VREF ~phi_b phi_b Vin net6 GND transistors3
x5 VDD Dx<7> Dx_b<7> VREF ~phi_b phi_b Vin net8 GND transistors3
x6 VDD Dx<9> Dx_b<9> VREF ~phi_b phi_b Vin net10 GND transistors3
x7 VDD Dx<8> Dx_b<8> VREF ~phi_b phi_b Vin net9 GND transistors3
x8 VDD Dx<6> Dx_b<6> VREF ~phi_b phi_b Vin net7 GND transistors3
x9 VDD Dx<3> Dx_b<3> VREF ~phi_b phi_b Vin net4 GND transistors3
x10 VDD Dx<1> Dx_b<1> VREF ~phi_b phi_b Vin net1 GND transistors3
.ends caps2

* ============================================================
* Per-bit CDAC switch subcircuit from supplied netlist
* ============================================================
.subckt transistors3 VDD Dx Dx_b VREF phi_s phi_s_b Vin sw_node GND
*.ipin Vin
*.ipin VREF
*.opin sw_node
*.ipin GND
*.ipin Dx
*.ipin Dx_b
*.ipin phi_s
*.ipin VDD
*.ipin phi_s_b
