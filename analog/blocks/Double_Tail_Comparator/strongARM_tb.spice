let kb_at_dec_lsb_6 = abs(kb_at_dec_6)/0.00703125
let kb_peak_2ns_mv_6 = kb_peak_2ns_6*1e3
let kb_peak_2ns_lsb_6 = kb_peak_2ns_6/0.00703125
let kb_residual_2ns_mv_6 = kb_residual_2ns_6*1e3
let kb_residual_2ns_lsb_6 = abs(kb_residual_2ns_6)/0.00703125

echo
