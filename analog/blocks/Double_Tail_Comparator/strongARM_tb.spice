* ============================================================
* RUN 7: requested INP-INN = +5 mV
* ============================================================
alter VCOMPREF 0.8981209
run

let kb_raw = v(Vx_loaded)-v(Vx_unloaded)
meas tran kb_pre_7 FIND kb_raw AT=59.9n
let kb_dyn_7 = kb_raw-kb_pre_7
let kb_abs_7 = abs(kb_dyn_7)

let outdiff_7 = v(OUTN)-v(OUTP)
let outdiff_abs_7 = abs(outdiff_7)

meas tran vx_pre_7 FIND v(Vx_loaded) AT=59.9n
meas tran vcomp_pre_7 FIND v(VCOMP) AT=59.9n
let actual_diff_7 = vx_pre_7-vcomp_pre_7

meas tran t_clk50_7 WHEN v(CLK)=1.65 RISE=1 FROM=59.9n TO=60.2n
meas tran t_dec_abs_7 WHEN outdiff_abs_7=1.65 RISE=1 FROM=60n TO=64.9n
let t_decision_7 = t_dec_abs_7-t_clk50_7

meas tran kb_before_dec_7 MAX kb_abs_7 FROM=$&t_clk50_7 TO=$&t_dec_abs_7
meas tran kb_at_dec_7 FIND kb_dyn_7 AT=$&t_dec_abs_7

meas tran kb_peak_2ns_7 MAX kb_abs_7 FROM=60n TO=62n
meas tran kb_residual_2ns_7 FIND kb_dyn_7 AT=62n
meas tran kb_pos_7 MAX kb_dyn_7 FROM=60n TO=62n
meas tran kb_neg_7 MIN kb_dyn_7 FROM=60n TO=62n

meas tran outdiff_final_7 FIND outdiff_7 AT=64.5n
let decision_metric_7 = actual_diff_7*outdiff_final_7

let actual_diff_mv_7 = actual_diff_7*1e3
let decision_time_ns_7 = t_decision_7*1e9
let kb_before_dec_mv_7 = kb_before_dec_7*1e3
let kb_before_dec_lsb_7 = kb_before_dec_7/0.00703125
let kb_at_dec_mv_7 = kb_at_dec_7*1e3
let kb_at_dec_lsb_7 = abs(kb_at_dec_7)/0.00703125
let kb_peak_2ns_mv_7 = kb_peak_2ns_7*1e3
let kb_peak_2ns_lsb_7 = kb_peak_2ns_7/0.00703125
let kb_residual_2ns_mv_7 = kb_residual_2ns_7*1e3
let kb_residual_2ns_lsb_7 = abs(kb_residual_2ns_7)/0.00703125

echo
echo ============================================================
echo INTERMEDIATE_RUN_7_REQUESTED_DIFF_p5mV
echo ============================================================
print actual_diff_mv_7
print decision_time_ns_7
print kb_before_dec_mv_7 kb_before_dec_lsb_7
print kb_at_dec_mv_7 kb_at_dec_lsb_7
print kb_peak_2ns_mv_7 kb_peak_2ns_lsb_7
print kb_residual_2ns_mv_7 kb_residual_2ns_lsb_7
print outdiff_final_7 decision_metric_7

wrdata comparator_sweep_run_7_p5mV.txt time kb_dyn_7 outdiff_abs_7 v(Vx_loaded) v(Vx_unloaded) v(CLK) v(OUTP) v(OUTN)

